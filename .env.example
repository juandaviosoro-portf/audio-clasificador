# ============================================
# Configuración del Sistema de Clasificación
# ============================================
# Copia este archivo como .env y completa los valores

# API Key de Google Gemini (obligatorio para clasificación con IA)
# Obtener en: https://aistudio.google.com/
GEMINI_API_KEY=TU_API_KEY_AQUI

# Clave secreta para Flask (cambiar en producción)
SECRET_KEY=mi-clave-secreta-cambiar-esto

# Modelo de Whisper: tiny, base, small, medium, large
# "base" es suficiente para demos, "small" si necesitas mejor precisión
WHISPER_MODEL=base

# Modelo de Gemini
GEMINI_MODEL=gemini-3.6-flash
